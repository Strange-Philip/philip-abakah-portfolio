---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionDivider from '../components/SectionDivider.astro';
import Work from '../components/Work.astro';
import SkillArea from '../components/SkillArea.astro';
import Footer from '../components/Footer.astro';
import { publications } from '../data/publications';

const allProjects = await getCollection('projects');
const researchProjects = allProjects
  .filter((p) => p.data.status === 'research')
  .sort((a, b) => a.data.order - b.data.order);

const researchThemes = [
  {
    number: '01',
    title: 'Computational Ophthalmic Imaging',
    bullets: [
      'OCT analysis',
      'Retinal / posterior eye structure',
      'Segmentation and quantitative characterization',
      '3D ocular modelling',
    ],
  },
  {
    number: '02',
    title: 'AI for Vision Science',
    bullets: [
      'Computer vision',
      'Deep learning',
      'AI-assisted vision assessment',
      'Clinical decision support',
    ],
  },
  {
    number: '03',
    title: 'Human-Centred Vision Technology',
    bullets: [
      'Assistive vision systems',
      'Accessibility',
      'Real-world evaluation',
      'On-device inference',
    ],
  },
];

const researchTrajectory =
  "My research interests have evolved from clinical optometry toward computational approaches to understanding and improving human vision. My earlier work explored AI-assisted mobility and vision assessment in real-world settings. I am now extending this foundation into ophthalmic imaging, focusing on OCT-based retinal analysis, image segmentation, and quantitative modelling of ocular structure.";

const awards = [
  {
    title: 'Caraham Ophthalmics Prize for Innovation in Optometry',
    description:
      'For the student who has demonstrated creativity and innovation in clinical practice, technology or research, with emphasis on improving the lives of people with vision loss.',
    year: '2025',
  },
];

const researchSkills = [
  { emoji: '🧠', name: 'PyTorch' },
  { emoji: '🩻', name: 'Medical Image Segmentation' },
  { emoji: '🔷', name: 'U-Net / CNN Architectures' },
  { emoji: '📊', name: 'Dice / IoU Evaluation' },
  { emoji: '🗂️', name: 'Dataset Curation & Splitting' },
  { emoji: '🎥', name: 'Real-Time Computer Vision' },
  { emoji: '📱', name: 'On-Device Inference' },
  { emoji: '🧬', name: 'Deep Learning Classification' },
  { emoji: '🔁', name: 'Data Augmentation' },
  { emoji: '🧪', name: 'Mixed-Method Research' },
  { emoji: '🙋🏾', name: 'Usability & Task-Completion Testing' },
  { emoji: '👁️', name: 'Vision Science Domain Knowledge' },
];
---

<BaseLayout
  title="Research — Philip Abakah"
  description="Research projects, publications, and skills at the intersection of optometry and machine learning."
>
  <Nav />
  <main id="main-content">
    <div class="container">
      <PageHeader
        emoji="🔬"
        title="Research"
      />
    </div>

    <!-- Research Interests -->
    <section class="container about-section">
      <SectionDivider label="Research Interests" />
      <div class="themes-grid">
        {researchThemes.map((theme) => (
          <SkillArea number={theme.number} title={theme.title} bullets={theme.bullets} />
        ))}
      </div>
    </section>

    <!-- Research Trajectory -->
    <section class="container research-intro">
      <SectionDivider label="Research Trajectory" />
      <p>{researchTrajectory}</p>
    </section>

    <!-- Projects -->
    <section class="about-section">
      <div class="container">
        <SectionDivider label="Projects" />
      </div>
      <Work projects={researchProjects} showAll />
    </section>

    <!-- Publications -->
    <section class="container about-section">
      <SectionDivider label="Publications" />
      {publications.map((pub) => (
        <div class="pub-card">
          <span class="pub-icon">📄</span>
          <div>
            <a href={pub.href} target="_blank" rel="noopener noreferrer" class="pub-title">
              {pub.title}
            </a>
            <div class="pub-meta">
              <span class="pub-venue">{pub.venue}</span>
              <span class="pub-year-badge">{pub.year}</span>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Awards -->
    <section class="container about-section">
      <SectionDivider label="Awards" />
      {awards.map((award) => (
        <div class="pub-card">
          <span class="pub-icon">🏆</span>
          <div>
            <p class="award-title">{award.title}</p>
            <p class="award-desc">{award.description}</p>
            <div class="pub-meta">
              <span class="pub-year-badge">{award.year}</span>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Research Skills -->
    <section class="container about-section about-section--last">
      <SectionDivider label="Research Skills" />
      <div class="stack-grid">
        {researchSkills.map((skill) => (
          <span class="stack-chip">
            <span class="chip-emoji">{skill.emoji}</span>
            {skill.name}
          </span>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .research-intro {
    padding-bottom: 48px;
  }

  .research-intro p {
    max-width: 640px;
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .about-section {
    padding-bottom: 48px;
  }

  .about-section--last {
    padding-bottom: 80px;
  }

  /* Research Interests */
  .themes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .themes-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .themes-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Publications */
  .pub-card {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-lg);
    margin-bottom: 32px;
  }

  .pub-icon {
    font-size: 20px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .pub-title {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.45;
    margin-bottom: 8px;
    transition: color 0.15s ease;
  }

  .pub-title:hover {
    color: var(--color-accent);
  }

  .pub-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .pub-venue {
    font-size: 12px;
    color: var(--color-text-tertiary);
  }

  .pub-year-badge {
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-mute);
    background: var(--color-bg-card);
    padding: 2px 7px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-soft);
  }

  /* Awards */
  .award-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.45;
    margin-bottom: 6px;
  }

  .award-desc {
    font-size: 12px;
    color: var(--color-text-tertiary);
    line-height: 1.6;
    margin-bottom: 8px;
  }

  /* Research Skills chips */
  .stack-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-soft);
    font-size: 13px;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .chip-emoji {
    font-size: 14px;
    line-height: 1;
  }
</style>
