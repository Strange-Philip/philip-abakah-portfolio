---
import { CLARITY_ID, LEADFEEDER_ID } from '../data/analytics';

// Only track production builds, never `npm run dev`.
const enabled = import.meta.env.PROD;
---

{enabled && CLARITY_ID && (
  <script is:inline define:vars={{ CLARITY_ID }}>
    (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window, document, "clarity", "script", CLARITY_ID);

    // Tag recordings with the project being viewed, e.g. /projects/safe-step → "safe-step"
    var projectMatch = location.pathname.match(/^\/projects\/([^/]+)/);
    if (projectMatch) window.clarity('set', 'project', projectMatch[1]);

    // Turn key link clicks into Clarity events (CV, email, socials, other outbound links)
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href]');
      if (!link) return;
      var href = link.getAttribute('href');
      var name = null;
      if (href.indexOf('mailto:') === 0) name = 'email_click';
      else if (href.indexOf('drive.google.com') !== -1) name = 'cv_click';
      else if (href.indexOf('linkedin.com') !== -1) name = 'linkedin_click';
      else if (href.indexOf('github.com') !== -1) name = 'github_click';
      else if (link.host && link.host !== location.host) name = 'outbound_click';
      if (name && window.clarity) window.clarity('event', name);
    });
  </script>
)}

{enabled && LEADFEEDER_ID && (
  <script is:inline define:vars={{ LEADFEEDER_ID }}>
    (function(ss,ex){ window.ldfdr=window.ldfdr||function(){(ldfdr._q=ldfdr._q||[]).push([].slice.call(arguments));}; (function(d,s){ fs=d.getElementsByTagName(s)[0]; function ce(src){ var cs=d.createElement(s); cs.src=src; cs.async=1; fs.parentNode.insertBefore(cs,fs); }; ce('https://sc.lfeeder.com/lftracker_v1_'+ss+(ex?'_'+ex:'')+'.js'); })(document,'script'); })(LEADFEEDER_ID);
  </script>
)}
